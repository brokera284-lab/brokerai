rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.role == 'super_admin' || request.auth.token.email == 'brokera284@gmail.com');
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerTenantId() {
      return callerProfile().tenantId;
    }

    function callerRole() {
      return callerProfile().role;
    }

    function sameTenant(resourceTenantId) {
      return isSignedIn() && callerTenantId() == resourceTenantId;
    }

    function isCompanyAdminOfTenant(tenantId) {
      return isSignedIn() && callerRole() == 'company_admin' && callerTenantId() == tenantId;
    }

    // ---------- /tenants ----------
    match /tenants/{tenantId} {
      allow read: if isSuperAdmin() || sameTenant(tenantId);
      allow write: if isSuperAdmin();

      match /settings/{settingId} {
        allow read: if isSuperAdmin() || sameTenant(tenantId);
        allow write: if isSuperAdmin() || isCompanyAdminOfTenant(tenantId);
      }
    }

    // ---------- /users ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /private/auth {
        allow read: if isSuperAdmin() || request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /favorites/{propertyId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /saved_searches/{searchId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth.uid == userId;
        allow write: if false;
      }

      match /ai_memory/{memoryId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ---------- /companies ----------
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid));
    }

    // ---------- /developers, /projects, /locations, /amenities, /settings/global_config ----------
    match /developers/{developerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSignedIn() && callerRole() == 'developer_admin');
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isSuperAdmin() || callerRole() == 'developer_admin';
    }
    match /locations/{locationId}   { allow read: if true; allow write: if isSuperAdmin(); }
    match /amenities/{amenityId}    { allow read: if true; allow write: if isSuperAdmin(); }
    match /settings/global_config   { allow read: if true; allow write: if isSuperAdmin(); }

    // ---------- /units & /properties ----------
    match /units/{unitId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.uploaderId == request.auth.uid || request.resource.data.brokerUid == request.auth.uid || request.resource.data.uploaderEmail == request.auth.email);
      allow update, delete: if isSuperAdmin() || (isSignedIn() && (resource.data.uploaderId == request.auth.uid || resource.data.brokerUid == request.auth.uid));

      match /images/{imageId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.brokerUid == request.auth.uid || request.resource.data.uploaderId == request.auth.uid);
      allow update, delete: if isSuperAdmin() || (isSignedIn() && (resource.data.brokerUid == request.auth.uid || resource.data.uploaderId == request.auth.uid));

      match /images/{imageId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ---------- /transactions ----------
    match /transactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // ---------- /refunds ----------
    match /refunds/{refundId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // ---------- /property_ai_analysis, /property_embeddings ----------
    match /property_ai_analysis/{propertyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /property_embeddings/{propertyId} {
      allow read, write: if false;
    }

    // ---------- /conversations ----------
    match /conversations/{conversationId} {
      allow read, update: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.participantUids);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if isSuperAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }

    // ---------- /leads ----------
    match /leads/{leadId} {
      allow read: if true;
      allow update, delete: if isSignedIn();
      allow create: if true;
    }

    // ---------- /analytics_events ----------
    match /analytics_events/{eventId} {
      allow read: if isSuperAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---------- /reports ----------
    match /reports/{reportId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isSuperAdmin();
    }

    // ---------- /reviews ----------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.reviewerUid == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // ---------- /search_cache ----------
    match /search_cache/{cacheId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- /activity_logs ----------
    match /activity_logs/{logId} {
      allow read: if isSuperAdmin() || isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
